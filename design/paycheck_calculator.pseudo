// Module Three Assignment: Paycheck Calculator Pseudocode
// Description: Calculates weekly gross pay including overtime for hours worked over 40.

START

    // Declare variables
    DECLARE hoursWorked AS FLOAT
    DECLARE hourlyRate AS FLOAT
    DECLARE regularPay AS FLOAT
    DECLARE overtimePay AS FLOAT
    DECLARE grossPay AS FLOAT

    // Initialize constant rates
    SET hourlyRate = 20.00
    SET overtimeRate = 30.00

    // Get input from user
    DISPLAY "Enter total hours worked this week: "
    INPUT hoursWorked

    // Decision branching for regular vs overtime pay
    IF hoursWorked <= 40 THEN
        SET regularPay = hoursWorked * hourlyRate
        SET grossPay = regularPay
    ELSE
        SET regularPay = 40 * hourlyRate
        SET overtimePay = (hoursWorked - 40) * overtimeRate
        SET grossPay = regularPay + overtimePay
    ENDIF

    // Output the final calculated weekly paycheck
    DISPLAY "Your total weekly paycheck is: $"
    DISPLAY grossPay
